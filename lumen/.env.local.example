# Supabase (Project Settings -> API). Only the anon key belongs in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Python categoriser (lumen/services/categorizer)
CATEGORIZER_URL=http://127.0.0.1:8001
CATEGORIZER_CONFIDENCE_THRESHOLD=0.45

# PDF statement extraction (Claude Haiku). Leave empty to disable PDF import.
ANTHROPIC_API_KEY=

# Optional server-side fallback for ticker resolution in portfolio risk.
GROQ_API_KEY=
